{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Settings",
  "description": "Configuration file stored in .api/settings.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to the JSON schema for validation"
    },
    "version": {
      "type": "integer",
      "description": "Schema version number",
      "const": 1
    },
    "apis": {
      "type": "array",
      "description": "List of discovered APIs in the project",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for this API — stable across machines for syncing"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for this API"
          },
          "rootDir": {
            "type": "string",
            "description": "Relative path to the root directory of this API"
          },
          "oasFile": {
            "type": "string",
            "description": "Relative path to the generated OAS file (e.g. .api/openapi.yaml)"
          },
          "framework": {
            "type": "string",
            "description": "Detected framework (e.g. Fastify, Express, Django)"
          },
          "language": {
            "type": "string",
            "description": "Detected programming language"
          },
          "baseUrl": {
            "type": "string",
            "description": "Production base URL for this API"
          },
          "localPort": {
            "type": "integer",
            "description": "Local development port"
          },
          "internal": {
            "type": "boolean",
            "description": "Whether this is an internal API (not public-facing)",
            "default": false
          },
          "lastSyncedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the last OAS sync"
          }
        },
        "required": ["id", "name", "rootDir", "oasFile", "language", "lastSyncedAt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "apis"],
  "additionalProperties": false
}
